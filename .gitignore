.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python（scripts/ 下的脚本被 import 时会生成）
__pycache__/
*.py[cod]

# Node (if tooling is ever added)
node_modules/
dist/
.cache/

# Environment / secrets
.env
.env.local
.env.*.local

# Temp
*.tmp
*.temp
tmp/

# SDD 临时工作区（任务简报、报告、审查包）
.superpowers/

# T.throws 判别力普查门（check.py）跑挂时留下的审计文件；门自己会删
chess/.throws-audit.*.json

# python/ 的 fixture 是程序要读的数据，文件名随题目定（access.log 之类）——不许被上面的 *.log 之类规则静默吞掉。
# 门读磁盘、本地全绿，CI 上却缺文件（第 3 期 m5a 的 access.log 就被 *.log 挡过一次）。
!python/programs/*/_fixtures/**
python/programs/*/_fixtures/**/.DS_Store
python/programs/*/_fixtures/**/._*
