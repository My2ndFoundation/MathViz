#!/bin/sh
# tools.json 是工具注册表的唯一真相。本钩子在提交前把它同步进 app.html 的内嵌清单，
# 并校验 index.html 的镜像是否一致，免得「记得手工同步」变成流程的一部分。
#
# 启用（每个克隆做一次）：
#     git config core.hooksPath .githooks
#
# 临时跳过：git commit --no-verify

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: 未找到 python3，跳过注册表同步检查与 chess / cryptography 子项目校验" >&2
  exit 0
fi

# 只在注册表或其镜像被改动时才跑，避免拖慢无关提交
# 注：不能在此提前 exit —— 下面的 chess 子项目检查要在同一次提交里独立触发
if git diff --cached --name-only | grep -qE '^(tools\.json|app\.html|index\.html)$'; then
  # 先记下哪些镜像文件在跑脚本之前就已经是脏的（别的会话正在写、或本次提交
  # 有意留了未暂存的改动）。只有「跑之前干净、跑之后变脏」的文件才是脚本自己
  # 改出来的，才可以替用户暂存——否则一个 git add 会把别人半写的文案一起卷进
  # 本次提交（CLAUDE.md「并行开工纪律」第 5 条记过的事故）。
  DIRTY_BEFORE=
  for f in app.html index.html; do
    git diff --quiet -- "$f" || DIRTY_BEFORE="$DIRTY_BEFORE $f"
  done

  # 写模式：app.html 的内嵌清单与 index.html 的 version/engine 能自动修就自动修；
  # index.html 的手写文案（desc / tag）只报告
  SYNC_FAILED=
  python3 scripts/sync_registry.py || SYNC_FAILED=1

  for f in app.html index.html; do
    git diff --quiet -- "$f" && continue                      # 脚本没动它
    case " $DIRTY_BEFORE " in
      *" $f "*)
        echo "pre-commit: $f 在同步前就有未暂存改动，不代为 git add —— 请自己确认后再暂存" >&2
        continue ;;
    esac
    git add "$f"
    echo "pre-commit: $f 已按 tools.json 重新生成并加入本次提交"
  done

  if [ -n "$SYNC_FAILED" ]; then
    echo "" >&2
    echo "pre-commit: 注册表镜像仍不同步（多半是 index.html 的 TOOLS 需要手工补文案）。" >&2
    echo "            修好后重新提交，或用 git commit --no-verify 跳过。" >&2
    exit 1
  fi
fi

# ---- 品牌资产（favicon / 侧栏标记）----
# 触发条件是 docs/logo.png 或脚本本身被改动。**不在这里因为「某个 html 改了」就触发**：
# 派生结果只取决于那张源图，与某一页改没改无关；新页面漏铺由 CI 的 --check 兜底
# （它扫的是 git ls-files 的全部 html，不看本次改了谁）。
if git diff --cached --name-only | grep -qE '^(docs/logo\.png|scripts/apply_branding\.py)$'; then
  BRAND_BEFORE=$(git diff --name-only)
  if ! python3 scripts/apply_branding.py; then
    echo "branding: apply_branding.py 失败，提交中止" >&2
    exit 1
  fi
  # 与上面注册表段同一条纪律：只暂存「跑之前干净、跑之后变脏」的文件，
  # 免得把别的会话半写的页面卷进本次提交。
  git diff --name-only | while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "
$BRAND_BEFORE
" in
      *"
$f
"*) echo "pre-commit: $f 在铺设品牌资产前就有未暂存改动，不代为 git add" >&2 ;;
      *) git add "$f" ;;
    esac
  done
fi

# ---- 版权署名 ----
# 触发条件是脚本本身被改动：署名内容只取决于它，与某一页改没改无关。
# 「新页面漏铺」由 CI 的 --check 兜底（它扫 git ls-files 的全部 html）——
# 与上面品牌资产段同一套分工，理由也相同。
if git diff --cached --name-only | grep -qE '^scripts/apply_footer\.py$'; then
  FOOTER_BEFORE=$(git diff --name-only)
  if ! python3 scripts/apply_footer.py; then
    echo "footer: apply_footer.py 失败，提交中止" >&2
    exit 1
  fi
  # 同一条纪律：只暂存「跑之前干净、跑之后变脏」的文件，免得把别的会话
  # 半写的页面卷进本次提交。
  git diff --name-only | while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "
$FOOTER_BEFORE
" in
      *"
$f
"*) echo "pre-commit: $f 在铺设版权署名前就有未暂存改动，不代为 git add" >&2 ;;
      *) git add "$f" ;;
    esac
  done
fi

# ---- chess 子项目 ----
if git diff --cached --name-only | grep -qE '^chess/(core|tools|scripts)/'; then
  # 只暂存 inline_core.py 这次实际改写过的文件（--print-changed 一行一个路径），
  # 不要 `git add chess/tools/*.html` 这种整体 glob——那会把其他并行会话
  # 半写的文件一起卷进本次提交（CLAUDE.md「并行开工纪律」第 2 条记过的事故：
  # 一次 replay-progress 修复因此带上了另一个工具的半成品，未注册就上了 main）。
  CHESS_CHANGED=$(python3 chess/scripts/inline_core.py --print-changed)
  if [ $? -ne 0 ]; then
    echo "chess: inline_core.py 失败，提交中止" >&2
    exit 1
  fi
  if [ -n "$CHESS_CHANGED" ]; then
    echo "$CHESS_CHANGED" | while IFS= read -r f; do
      [ -n "$f" ] && git add "$f"
    done
  fi
  if ! python3 chess/scripts/check.py; then
    echo "chess: check.py 未通过，提交中止" >&2
    exit 1
  fi
fi

# ---- cryptography 子项目 ----
# 与 chess 段同构。只暂存 inline_core.py 这次实际改写过的文件
# （--print-changed 一行一个路径），不要 `git add cryptography/tools/*.html`
# 这种整体 glob——那会把其他并行会话半写的文件一起卷进本次提交
# （CLAUDE.md「并行开工纪律」第 2 条记过这次事故）。
if git diff --cached --name-only | grep -qE '^cryptography/(core|examples|tools|scripts)/'; then
  CRYPTO_CHANGED=$(python3 cryptography/scripts/inline_core.py --print-changed)
  if [ $? -ne 0 ]; then
    echo "cryptography: inline_core.py 失败，提交中止" >&2
    exit 1
  fi
  if [ -n "$CRYPTO_CHANGED" ]; then
    echo "$CRYPTO_CHANGED" | while IFS= read -r f; do
      [ -n "$f" ] && git add "$f"
    done
  fi
  if ! python3 cryptography/scripts/check.py; then
    echo "cryptography: check.py 未通过，提交中止" >&2
    exit 1
  fi
fi

# ---- python 子项目 ----
# 与 chess / cryptography 两段同构，但**有两个生成脚本**而不是一个：
#   · inline_core.py    —— python/core/**/*.js  → tools/*.html 的 GENERATED:<模块> 区段
#   · build_programs.py —— python/programs/ch*/ → tools/*.html 的 GENERATED:PROGRAMS 区段，
#                          外加把 programs / lines 两个派生字段回写进 python-tools.json
# 触发条件因此比 chess 段多一个 programs/。两个脚本都只暂存自己 --print-changed
# 打印出来的路径——同 chess 段那条纪律：整体 glob 会把别的会话半写的文件卷进本次提交。
if git diff --cached --name-only | grep -qE '^python/(core|programs|tools|scripts)/'; then
  PY_CORE_CHANGED=$(python3 python/scripts/inline_core.py --print-changed)
  if [ $? -ne 0 ]; then
    echo "python: inline_core.py 失败，提交中止" >&2
    exit 1
  fi
  PY_PROG_CHANGED=$(python3 python/scripts/build_programs.py --print-changed)
  if [ $? -ne 0 ]; then
    echo "python: build_programs.py 失败，提交中止" >&2
    exit 1
  fi
  for CHANGED in "$PY_CORE_CHANGED" "$PY_PROG_CHANGED"; do
    [ -n "$CHANGED" ] || continue
    echo "$CHANGED" | while IFS= read -r f; do
      [ -n "$f" ] && git add "$f"
    done
  done
  if ! python3 python/scripts/check.py; then
    echo "python: check.py 未通过，提交中止" >&2
    exit 1
  fi
fi

# ---- 导航契约（六个导航页）----
# 触发条件是任何一个导航页或本门自己被改动。这道门守的是「同一个导航行为必须
# 同时落在全部子项目上」：`?v=` 曾经只在 cryptography 有、chess 整整一季没有，
# 六个导航页之间没有共享代码，只能靠跨页比对。
#
# ⚠ 根目录那两页与子项目那六页**分开写成两个顶层分支**，故意不合并成
#   `^((chess|cryptography|python)/)?(app|index)\.html$`。那个更短的写法在
#   ugrep 7.8.4（本机 PATH 上的 `grep`）下**会漏掉 `cryptography/app.html`**
#   ——只漏这一条，chess/ 与 python/ 照常命中，且稳定复现；/usr/bin/grep 与
#   Python 的 re 都认为它该匹配。可选捕获组 `(…)?` 套交替是触发条件。
#   漏掉的后果是这道门对那一页静默失效，而本机与 CI 会给出不同的结论——
#   正是 CLAUDE.md 里「本机绿不算绿」那一类。下面的写法在两个 grep 下都对。
if git diff --cached --name-only | grep -qE '^(app|index)\.html$|^(chess|cryptography|python)/(app|index)\.html$|^scripts/check_nav_contract\.py$'; then
  if ! python3 scripts/check_nav_contract.py; then
    echo "nav-contract: check_nav_contract.py 未通过，提交中止" >&2
    exit 1
  fi
fi

exit 0
