<canvas id="bg" aria-hidden="true"></canvas>
<style>
/* 背景荧光屏：铺满视口、垫在内容层之下。内容层 .wrap 必须叠在它上面，
   所以 z-index 也在这里一起给——漏了这一条，画布会盖住整个画廊。 */
#bg{position:fixed;inset:0;z-index:0;display:block;pointer-events:none}
body > .wrap{position:relative;z-index:1}
</style>
<script>
/* 背景荧光屏：几条缓慢流动的示波器轨迹，呼应工具本身「画布即主角」的美学。
   唯一的编辑源是 scripts/gallery-bg.fragment，由 scripts/apply_gallery_bg.py
   原样铺进四个画廊（根 index.html 与三个子项目的 index.html）——四份逐字节相同，
   --check 守着。不要在任何一页里直接改这一段。

   写成自包含的 IIFE：画廊页自己的脚本里已经有 g / W / H 之类的名字，
   顶层 const 会撞。取不到 2d 上下文（导航契约门在 node vm 里用桩 DOM 跑页面脚本，
   桩的 getContext 返回 null）或没有 requestAnimationFrame 时安静退出，不抛错。 */
(function () {
  var cv = document.getElementById('bg');
  var g = (cv && typeof cv.getContext === 'function') ? cv.getContext('2d') : null;
  if (!g) return;

  var W = 0, H = 0, DPR = 1, grad = null;
  function resize() {
    DPR = Math.min(2, window.devicePixelRatio || 1);
    W = window.innerWidth; H = window.innerHeight;
    cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
    cv.style.width = W + 'px'; cv.style.height = H + 'px';
    g.setTransform(DPR, 0, 0, DPR, 0, 0);
    grad = g.createRadialGradient(W * 0.5, H * 0.30, 0, W * 0.5, H * 0.42, Math.max(W, H) * 0.95);
    grad.addColorStop(0, '#0c1526');
    grad.addColorStop(1, '#05070d');
  }
  window.addEventListener('resize', resize);
  resize();

  var TAU = Math.PI * 2;
  var traces = [
    { c: 'rgba(45,212,234,0.15)',  w: 1.6, amp: 0.11,  freq: 2.1, speed:  0.20, phase: 0.0 },
    { c: 'rgba(251,113,133,0.12)', w: 1.4, amp: 0.075, freq: 3.2, speed: -0.15, phase: 1.7 },
    { c: 'rgba(167,139,250,0.10)', w: 1.2, amp: 0.05,  freq: 4.7, speed:  0.11, phase: 3.1 }
  ];
  var REDUCED = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

  function drawTrace(t, time) {
    var midY = H * 0.5, A = H * t.amp;
    g.beginPath();
    for (var x = 0; x <= W; x += 6) {
      var u = x / W;
      var env = Math.sin(u * Math.PI);              // 两端渐隐的包络
      var y = midY + A * env * Math.sin(u * TAU * t.freq + time * t.speed + t.phase);
      if (x === 0) g.moveTo(x, y); else g.lineTo(x, y);
    }
    g.lineWidth = t.w; g.strokeStyle = t.c; g.lineCap = 'round';
    g.stroke();
  }
  function render(time) {
    g.fillStyle = grad; g.fillRect(0, 0, W, H);
    for (var i = 0; i < traces.length; i++) drawTrace(traces[i], time);
  }
  function frame(ts) {
    render((ts || 0) / 1000);
    window.requestAnimationFrame(frame);
  }
  if (REDUCED || typeof window.requestAnimationFrame !== 'function') render(0);
  else window.requestAnimationFrame(frame);
})();
</script>
