{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!app/.next",
      "!app/drizzle/meta",
      "!build",
      "!out",
      "!test-results",
      "!app/public/recorder"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": { "noDefaultExport": "error" }
    },
    "domains": { "next": "recommended", "react": "recommended" }
  },
  "overrides": [
    {
      "includes": [
        "app/src/app/**/page.tsx",
        "app/src/app/**/layout.tsx",
        "app/src/app/**/loading.tsx",
        "app/src/app/**/error.tsx",
        "app/src/app/**/global-error.tsx",
        "app/src/app/**/not-found.tsx",
        "app/src/app/**/template.tsx",
        "app/src/app/**/default.tsx",
        "*.config.ts",
        "**/next.config.mjs",
        "tests/e2e/setup.ts",
        "**/*.d.ts"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
