{
  "name": "mathviz-pfapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun scripts/recorder.ts && next dev app -H 127.0.0.1",
    "build": "bun scripts/build-local.ts",
    "build:next": "next build app",
    "stage:pfapp": "bun scripts/stage-pfapp.ts",
    "stage:addon": "bun scripts/stage-addon.ts",
    "record:addon": "bun scripts/record-addon.ts",
    "start": "next start app -H 127.0.0.1",
    "lint": "biome check --error-on-warnings",
    "format": "biome format --write",
    "typecheck": "next typegen app && tsc --noEmit",
    "extract": "bun extract/cli.ts",
    "check:content": "bun scripts/check.ts",
    "db:generate": "drizzle-kit generate",
    "test": "bun test ./tests/unit ./tests/integration",
    "test:unit": "bun test ./tests/unit",
    "test:integration": "bun test ./tests/integration",
    "test:e2e": "playwright test",
    "icons": "bun scripts/icons.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "drizzle-orm": "^0.45.4",
    "markdown-it": "14.1.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "~1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.3",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  }
}
