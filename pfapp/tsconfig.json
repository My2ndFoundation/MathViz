{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["bun", "node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./app/src/*"] }
  },
  "include": [
    "app/next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "tests/**/*.ts",
    "app/.next/types/**/*.ts",
    "app/.next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "test-results"]
}
