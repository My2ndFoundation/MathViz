{
  "id": "app.primeforge.mathviz.math",
  "name": "Viz Learn Buddy for Math",
  "version": "1.0.2",
  "runtime": "node@24",
  "entry": "primeforge-entry.mjs",
  "surface": "http",
  "capabilities": ["ai", "addons"],
  "port": 26454,
  "art": {
    "icon": "icon.svg"
  },
  "ui": {
    "window": {
      "width": 1280,
      "height": 820,
      "minWidth": 900,
      "minHeight": 600
    }
  },
  "minDesktopVersion": "1.45.0",
  "ai": {
    "mcp": {
      "path": "/api/mcp",
      "jobPathPrefix": "/api/mcp/t/"
    },
    "tools": {
      "deny": []
    },
    "workflows": [
      {
        "id": "ask",
        "maxTurns": 6,
        "maxBudgetUsd": 0.15,
        "maxRuntimeSeconds": 150,
        "tools": {
          "allow": ["mv_get_task", "mv_read_item", "mv_submit_answer"]
        }
      },
      {
        "id": "library",
        "maxTurns": 10,
        "maxBudgetUsd": 0.4,
        "maxRuntimeSeconds": 300,
        "tools": {
          "allow": [
            "mv_get_task",
            "mv_search_library",
            "mv_read_item",
            "mv_list_groups",
            "mv_submit_answer"
          ]
        }
      }
    ]
  }
}
