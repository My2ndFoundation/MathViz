{
  "id": "app.primeforge.mathviz.python",
  "name": "MathViz Python",
  "version": "0.1.0",
  "runtime": "node@24",
  "entry": "primeforge-entry.mjs",
  "surface": "http",
  "capabilities": ["ai", "addons"],
  "port": 26457,
  "art": {
    "icon": "icon.svg"
  },
  "minDesktopVersion": "1.45.0",
  "ai": {
    "mcp": {
      "path": "/api/mcp",
      "jobPathPrefix": "/api/mcp/t/"
    },
    "tools": {
      "deny": []
    },
    "workflows": [
      {
        "id": "ask",
        "maxTurns": 6,
        "maxBudgetUsd": 0.15,
        "maxRuntimeSeconds": 150,
        "tools": {
          "allow": ["mv_get_task", "mv_read_item", "mv_submit_answer"]
        }
      },
      {
        "id": "hint",
        "maxTurns": 4,
        "maxBudgetUsd": 0.08,
        "maxRuntimeSeconds": 90,
        "tools": {
          "allow": ["mv_get_task", "mv_submit_answer"]
        }
      },
      {
        "id": "library",
        "maxTurns": 10,
        "maxBudgetUsd": 0.4,
        "maxRuntimeSeconds": 300,
        "tools": {
          "allow": [
            "mv_get_task",
            "mv_search_library",
            "mv_read_item",
            "mv_list_groups",
            "mv_submit_answer"
          ]
        }
      }
    ]
  }
}
